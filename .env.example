GOOGLE_API_KEY=api_key_aqui
# Deja vacio para que la app pruebe modelos Flash tipicos del free tier (AI Studio).
# Si quieres uno fijo, copia el ID exacto desde el selector de modelo en https://aistudio.google.com
GEMINI_MODEL=
HF_TOKEN=hf_token_aqui
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
OLLAMA_MODEL=llama3.2:3b
# Si Ollama escucha en otro host/puerto (por defecto http://127.0.0.1:11434):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHROMA_PERSIST_DIR=chroma_db
RAG_TOP_K=4
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_MIN_RELEVANCE=0.2
